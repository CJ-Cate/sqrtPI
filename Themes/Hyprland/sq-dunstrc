# some docs, better just use chatgpt: https://randomgeekery.org/config/linux/dunst/dunstrc/
[global]
monitor = HDMI-A-1
follow = none
origin = top-left
offset = (40,40) # horiztontal offset, vertical offset
corner_radius = 10
font = Monospace 13 # scale up a bit
timeout = 9 # seconds
#
frame_color = "#48cae4"
separator_color= frame
highlight = "#8aadf4"

#[urgency_low]
#background = "#24273a"
#foreground = "#cad3f5"

#[urgency_normal]
#background = "#24273a"
#foreground = "#cad3f5"

[urgency_critical]
timeout = 0 # never expire
background = "#24273a"
foreground = "#cad3f5"
frame_color = "#ff2222"
