{
    "reload_style_on_change": true,
    "height": 48, // Min 48: the two-line clock requires it
    "spacing": 4, // Default 4
    "position": "bottom",

    "modules-left": [
        "custom/taskbarbutton",
        "hyprland/workspaces"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "network#wlan0",
        "network#tun0",
        "battery",
        "pulseaudio",
        "clock#time"
    ],
    
    // Rendered via CSS background-image (see #custom-taskbarbutton in sq-style.css).
    // The built-in `image` module spins waybar's main loop and the bar then never
    // commits a first frame, leaving an invisible layer at alpha 0.
    "custom/taskbarbutton": {
        "format": " ",
        "on-click": "~/sqrtPI/Scripts/rofilaunch.sh",
        "tooltip": false
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock#time": {
        "format": "{:%H:%M %p\n%m/%d/%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },
    "hyprland/workspaces":{
        "separate-outputs":true,
        "format": "{id}",
        "on-click": "activate",
         "persistent-workspaces": {
              "DP-1": [1, 2, 3, 4, 5, 6],
              "HDMI-A-1": [1, 2, 3, 4, 5, 6]
          }
    },
    "pulseaudio":{
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },
    "network#wlan0": {
        "interface": "wlan0",
        "format": "{ifname}",
        //"format-wifi": "{essid} ",
        "format-wifi": "Wifi ",
        "format-disconnected": "No wlan0",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "Signal strength: ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Meow :3"
    },
    "network#tun0": {
        "type": "network",
        "interface": "tun0",
        "format": "tun0: {ipaddr}/{cidr}",
        "format-disconnected": "Disconnected from tun0",
        "on-click": "~/sqrtPI/Scripts/getTun0.sh 'Copied!'"
    }
}
